# Repo-wide ignores. Each app (backend/, frontend/) also has its own .gitignore.

# Dependencies and local env files, in any app folder
node_modules/
.env
.env.*
!.env.example

# IDEs and editors
.idea/
.vscode/*
!.vscode/extensions.json

# OS files
.DS_Store
Thumbs.db

# Claude Code: personal settings stay on this computer
.claude/settings.local.json
