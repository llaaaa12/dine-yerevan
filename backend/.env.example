# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
PORT=3000
# Frontend address: OAuth redirects and links in emails point here
APP_URL=http://localhost:5173
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173
# Local Docker database from compose.yaml (docker compose up -d)
DB_HOST=localhost
DB_NAME=dine_yerevan
DB_PORT=5432
DB_PASSWORD=dine
DB_USER=dine
# true for hosted databases that require TLS (Neon); false for the local Docker one
DB_SSL=false
